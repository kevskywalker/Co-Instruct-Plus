# Optional local overrides (gitignored as env.local.sh).
# Scripts auto-source configs/env.local.sh when present — no manual `source` needed.
#
#   cp configs/env.example configs/env.local.sh
#   # edit, then just: bash scripts/finetune_stage1.sh 0,1,2,3
#
# Defaults without this file:
#   MODEL_NAME=Qwen/Qwen3-VL-8B-Instruct   (Hub download on first run)
#   ANNOTATIONS_DIR=data/annotations or training_jsons/
#   DATA_PATH=configs/qsit_multi.yaml
#   OUTPUT_DIR=checkpoints/stage1_qsit_sft
#   MODEL=checkpoints/stage1_qsit_sft
#   PAIRS_JSON=pairs/pairs_180k.json
#   OUTPUT=checkpoints/stage2_score
#   KonIQ-only: bash scripts/gen_soft_label_koniq.sh && bash scripts/train_score_stage2_koniq.sh
#     KONIQ_META=$ROOT_DATA/koniq10k/metas/train_koniq_7k.json
#     KONIQ_OUTPUT=checkpoints/stage2_score_koniq
#
# Still required via export or this file:
#   IMAGE_FOLDER   Stage-1 image root (parent of data/)
#   ROOT_DATA      Stage-2 / eval pair+benchmark image root

export IMAGE_FOLDER=/path/to/Co-Instruct-plus
export ROOT_DATA=/path/to/pair-or-benchmark-images

# Optional overrides:
# export MODEL_NAME=/path/to/local/Qwen3-VL-8B-Instruct
# export ANNOTATIONS_DIR=/path/to/training_jsons
# export OUTPUT_DIR=/path/to/Co-Instruct-Plus/checkpoints/stage1_qsit_sft
# export MODEL=/path/to/Co-Instruct-Plus/checkpoints/stage1_qsit_sft
# export PAIRS_JSON=/path/to/pairs/pairs_180k.json
# export OUTPUT=/path/to/Co-Instruct-Plus/checkpoints/stage2_score
# KonIQ-only Stage 2 (scripts/train_score_stage2_koniq.sh):
# export KONIQ_META=/path/to/koniq10k/metas/train_koniq_7k.json
# export KONIQ_OUTPUT=/path/to/Co-Instruct-Plus/checkpoints/stage2_score_koniq
# export ENV_NAME=train
# export COINSTRUCT_SEED=42
