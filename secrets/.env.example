# Copy to secrets/.env and fill in values (secrets/.env is gitignored):
#   cp secrets/.env.example secrets/.env
#   chmod 600 secrets/.env
#
# Launchers and scripts/download_annotations.sh auto-source secrets/.env.
# Hugging Face CLI also reads HF_TOKEN.

# Hugging Face write token for yluo016 (https://huggingface.co/settings/tokens)
HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=

# Optional: GitHub, if you later push the code repo
# GITHUB_TOKEN=
